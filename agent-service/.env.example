# agent-service 配置示例：复制为 .env 后填写。.env 已在 .gitignore 中，不要提交真实密钥。

# ---- LLM（三选一，优先级 CHAT_* > DEEPSEEK_* > OPENAI_*）----
CHAT_API_KEY=
CHAT_MODEL=
CHAT_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# 单次 LLM 请求超时（秒）；重试由 harness 的 ModelRetryPlugin 负责
LLM_TIMEOUT_SECONDS=60
# 只在本地演示/测试时打开：没有 API Key 时返回 mock 结论。生产必须为 0
LLM_MOCK=0

# ---- Embedding（知识检索）----
EMBEDDING_OPENAI_API_KEY=
EMBEDDING_OPENAI_MODEL=text-embedding-3-small
EMBEDDING_OPENAI_BASE_URL=

# ---- Java 后端 ----
JAVA_BACKEND_BASE_URL=http://localhost:8080
# Python -> Java 内部接口鉴权（需与 Java app.internal.api-key 一致）
JAVA_INTERNAL_API_KEY=change-me
JAVA_HTTP_MAX_RETRIES=3
JAVA_HTTP_RETRY_BACKOFF_SECONDS=0.5
TOOL_TIMEOUT_SECONDS=30

# ---- agent-service 服务 ----
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8090
# Java -> Python 入站鉴权；为空表示不校验（仅本地开发）
AGENT_SERVICE_API_KEY=
# 同时执行的诊断任务数，超出的排队
MAX_CONCURRENT_JOBS=4
# Skill SOP 目录；Docker 中为 /app/skills，本地留空即使用源码里的 agent-service/skills
SKILLS_DIR=

# ---- Harness 预算（token 统计现在是真实的，请先用真实 Key 跑几次再校准）----
HARNESS_MAX_TURNS=20
HARNESS_MAX_TOKENS=120000
HARNESS_MAX_GRAPH_STEPS=25
HARNESS_TIMEOUT_SECONDS=300

# ---- 编排 ----
MAX_REACT_ITERATIONS=3
EVALUATOR_RETRY_LIMIT=2
MAX_GLOBAL_REPLANS=1
MAX_AGENT_HANDOFFS=2
RETRIEVAL_TOP_K=5
RERANK_ENABLED=true
# 发给模型的单段证据最大字符数，超出会截断并在 payload.truncation 中标记
EVIDENCE_TEXT_LIMIT=2000
SKILL_PROCEDURE_LIMIT=4000

# ---- 日志 ----
AGENT_JSON_LOGS=0
