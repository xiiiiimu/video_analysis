# docker compose 使用的环境变量。复制为 .env（与 docker-compose.yml 同目录）后修改。
# .env 已加入 .gitignore，不要提交真实密钥。

# Java <-> agent-service 内部调用密钥（双向共用）
INTERNAL_API_KEY=please-change-me
# agent-service 入站鉴权直接复用 INTERNAL_API_KEY（见 docker-compose.yml），无需单独配置

MYSQL_ROOT_PASSWORD=please-change-me
MYSQL_USER=video
MYSQL_PASSWORD=please-change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=please-change-me

# LLM：至少配置一个；只做演示时可以设 LLM_MOCK=1
CHAT_API_KEY=
CHAT_MODEL=
CHAT_BASE_URL=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MOCK=0

MAX_CONCURRENT_JOBS=4
HARNESS_MAX_TOKENS=200000

# 宿主机端口（只绑定 127.0.0.1）。本机已有服务占用时改这里，容器内部端口不受影响
MYSQL_PORT=3307
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
APP_PORT=8080
AGENT_PORT=8090

# 视频分析窗口（秒）与抽帧
ANALYSIS_WINDOW_SECONDS=120
FRAME_INTERVAL_SECONDS=3
MAX_KEYFRAMES=60
OCR_PARALLELISM=4

# 语音转写：留空时依次复用 OPENAI_API_KEY、CHAT_API_KEY（CHAT 用 DeepSeek 时必须单独填）
ASR_API_KEY=
ASR_MODEL=whisper-1
# 可选语言提示，如 zh；留空自动识别
ASR_LANGUAGE=
